{
  "name": "interconnection-atlas",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive D3 map of US grid interconnection: a hosting-capacity choropleth with the interconnection queue and ISO/RTO territories overlaid.",
  "type": "module",
  "license": "MIT",
  "author": "John Carmack",
  "homepage": "https://johncarmack1984.github.io/interconnection-atlas/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johncarmack1984/interconnection-atlas.git"
  },
  "bugs": {
    "url": "https://github.com/johncarmack1984/interconnection-atlas/issues"
  },
  "keywords": [
    "d3",
    "d3-geo",
    "choropleth",
    "map",
    "react",
    "interconnection",
    "grid",
    "iso-rto",
    "geojson",
    "topojson",
    "data-visualization"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "pnpm --filter interconnection-atlas-examples dev",
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "d3": "^7.9.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3": "^7.4.3",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "vitest-axe": "^0.1.0"
  },
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c"
}
